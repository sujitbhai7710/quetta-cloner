# build outputs
dist*/
*.log

# the source APK is attached to the apk-source GitHub release, never committed
# (GitHub blocks files larger than 100 MB in git)
Quetta.apk
*.apk
*.apks
*.xapk
splits/

# Per-clone keystores ARE committed (in keystores/) so updates work across runs.
# Each clone has its own unique key. The keystore password is "android" (not
# secret) — the keystore's purpose is signing identity, not encryption.
# Legacy keystore/ dir (single shared key) is still ignored:
keystore/
*.jks

# python
__pycache__/
*.pyc
joblog.txt

# Java build artifacts (compiled in CI from QuettaClone.java)
QuettaClone.class
QuettaClone$*.class
QuettaClone.jar
